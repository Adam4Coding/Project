import yfinance as yf
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error
import warnings
warnings.filterwarnings('ignore')

# Download stock data
ticker = 'AAPL'  # S&P 500 ETF
data = yf.download(ticker, start='2025-01-01', end='2026-03-27', 
                   auto_adjust=True)['Close']

# Calculate daily returns
returns = data.pct_change().dropna()

# Calculate realized monthly volatility (what actually happened)
monthly_vol = returns.resample('ME').std() * np.sqrt(21)

# Build features for prediction
vol_df = pd.DataFrame(monthly_vol)
vol_df.columns = ['realized_vol']

# Feature 1: Last month's volatility
vol_df['lag1'] = vol_df['realized_vol'].shift(1)

# Feature 2: Average volatility over last 3 months
vol_df['lag3_mean'] = vol_df['realized_vol'].shift(1).rolling(3).mean()

# Feature 3: Average volatility over last 6 months
vol_df['lag6_mean'] = vol_df['realized_vol'].shift(1).rolling(6).mean()

# Drop missing values
vol_df = vol_df.dropna()

# Split into training and test sets (80/20 split)
split = int(len(vol_df) * 0.8)
train = vol_df.iloc[:split]
test = vol_df.iloc[split:]

# Define features and target
features = ['lag1', 'lag3_mean', 'lag6_mean']
X_train = train[features]
y_train = train['realized_vol']
X_test = test[features]
y_test = test['realized_vol']

# Train linear regression model
model = LinearRegression()
model.fit(X_train, y_train)

# Make predictions
predictions = model.predict(X_test)

# Calculate performance metrics
mse = mean_squared_error(y_test, predictions)
rmse = np.sqrt(mse)
correlation = np.corrcoef(y_test, predictions)[0,1]

print(f"Root Mean Squared Error: {rmse:.4f}")
print(f"Correlation (predicted vs actual): {correlation:.4f}")
print(f"\nModel Coefficients:")
for feat, coef in zip(features, model.coef_):
    print(f"  {feat}: {coef:.4f}")

# Plot predicted vs actual volatility
plt.figure(figsize=(12,6))
plt.plot(test.index, y_test.values, label='Actual Volatility', color='blue')
plt.plot(test.index, predictions, label='Predicted Volatiliaty', 
         color='orange', linestyle='--')
plt.title('Volatility Forecasting Model')
plt.xlabel('Date')
plt.ylabel('Monthly Volatility')
plt.legend()
plt.savefig('volatility_forecast.png')
plt.show()
