# Medical Data Statistical Analysis
# Author: Adam Jada
# Tools: R
# Description: Statistical analysis of medical patient data including
# linear regression, multiple regression, one-way ANOVA, and two-way ANOVA
# to analyze body composition and triglyceride patterns across patient groups

# Import data
med <- read.csv("medicaldata2.csv", header = TRUE)
str(med)

# Task 1: Convert vartaibles to factors
med$Gallstone_Status <- factor(med$Gallstone_Status,
                               levels = c(0,1),
                               labels = c("Yes", "No"))

med$Comorbidity <- factor(med$Comorbidity,
                          levels = c(0,1,2,3),
                          labels = c("0", "1","2", "3"),
                          ordered = TRUE)

med$CAD <- factor(med$CAD,
                  levels = c(0,1),
                  labels = c("No", "Yes"))

med$Diabetes_Mellitus <- factor(med$Diabetes_Mellitus,
                                levels = c(0,1),
                                labels = c("No", "Yes"))

med$Hepatic_Fat_Accumulation <- factor(med$Hepatic_Fat_Accumulation,
                                       levels = c(0,1,2,3),
                                       labels = c("0", "1", "2","3"),
                                       ordered = TRUE)

med$Age_Class <- factor(med$Age_Class,
                        levels = c("Younger", "Lower Middle",
                                   "Upper Middle", "Elder"),
                        ordered = TRUE)
str(med)

# Task 2: Linear Regression Model
# Scatterplot
plot(med$Body_Protein_Content, med$Total_Body_Fat_Ratio, 
     xlab = "Body Protein Content (%)",
     ylab = "Total Body Fat Ratiio (%)",
     main = "Total Body Fat vs Body Protein Content")
# Linear Regression
fat_model <- lm(Total_Body_Fat_Ratio ~ Body_Protein_Content, data = med)
fat_summary <- summary(fat_model)
fat_summary

# Extract the slope, R Squared and Intercept
fat_intercept <- coef(fat_model)[1]
fat_slope <- coef(fat_model)[2]
fat_R2 <- fat_summary$r.squared

fat_intercept; fat_slope; fat_R2

# Assumptions
fat_resid <- residuals(fat_model)
fat_fitted <- fitted(fat_model)

# Linearity Check
plot(med$Body_Protein_Content, fat_resid,
     xlab = "Body Protein Content",
     ylab = "Residuals",
     main = "Residuals vs Body Protein Content")
abline(h = 0, lty = 2)

# Normality
qqnorm(fat_resid, main = "Q-Q Plot (Task 2 Residuals)")
qqline(fat_resid, col = "red")

fat_norm_test <- shapiro.test(fat_resid)
fat_norm_test

# Equal Variance check
plot(fat_fitted, fat_resid,
     xlab = "Fitted Values",
     ylab = "Residuals",
     main = "Residuals vs Fitted (Task 2)")
abline(h = 0, lty = 2)

# Correlation
fat_r <- cor(med$Body_Protein_Content, med$Total_Body_Fat_Ratio,
             use = "complete.obs")
fat_r

# Task 3: Multiple Linear Regression
water_model <- lm(Total_Body_Water ~ Height + Weight + Body_Protein_Content,
                  data = med)
water_summary <- summary(water_model)
water_summary

# R squared
water_R2 <- water_summary$r.squared
