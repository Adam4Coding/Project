plot(med$Body_Protein_Content, water_resid,
     main = "Res vs Protein", xlab = "Protein Content", ylab = "Residuals")
abline(h = 0, lty = 2)

par(mfrow=c(1,1))

# Normality
qqnorm(water_resid, main = "Task 3 Q-Q Plot")
qqline(water_resid, col = "red")

water_norm_test <- shapiro.test(water_resid)
water_norm_test

# Equal variance
plot(water_fitted, water_resid,
     main = "Residuals vs Fitted",
     xlab = "Fitted Values", ylab = "Residuals")
abline(h = 0, lty = 2)

# Independence residuals vs order
water_summary$fstatistic
plot(water_resid, type = "b",
     main = "Residuals vs Order (Independence Check)",
     xlab = "Observation Index", ylab = "Residuals")
abline(h = 0, lty = 2)

# Partial Tests
coef_table3 <- water_summary$coefficients
coef_table3

p_height <- coef_table3["Height", "Pr(>|t|)"]
p_weight <- coef_table3["Weight", "Pr(>|t|)"]
p_protein <- coef_table3["Body_Protein_Content", "Pr(>|t|)"]

p_height; p_weight; p_protein

# Task 4: One way anova test
age_model <- aov(Total_Body_Fat_Ratio ~ Age_Class, data = med)
age_anova <- anova(age_model)
age_anova

# Normality
age_resid <- residuals(age_model)

qqnorm(age_resid, main = "Age Class ANOVA Q-Q Plot")
qqline(age_resid, col = "red")

age_norm_test <- shapiro.test(age_resid)
age_norm_test

# Equal variance
age_var_test <- bartlett.test(Total_Body_Fat_Ratio ~ Age_Class, data = med)
age_var_test

# Tukey
age_tukey <- TukeyHSD(age_model, conf.level = 0.98)
age_tukey

boxplot(Total_Body_Fat_Ratio ~ Age_Class, data = med,
        main = "Total Body Fat Ratio by Age Class",
        xlab = "Age Class",
        ylab = "Total Body Fat Ratio (%)")

# Task 5: Two Way ANOVA

# Barplots
diab_means <- tapply(med$Triglyceride, med$Diabetes_Mellitus, mean)
hep_means <- tapply(med$Triglyceride, med$Hepatic_Fat_Accumulation, mean)

barplot(diab_means, main = "Triglyceride by Diabetes Status",
        xlab = "Diabetes", ylab = "Mean Triglyceride")

barplot(hep_means, main = "Triglyceride by Hepatic Fat Grade",
        xlab = "Fat Grade", ylab = "Mean Triglyceride")

# Two way model
tri_model <- aov(Triglyceride ~ Diabetes_Mellitus * Hepatic_Fat_Accumulation,
                 data = med)
tri_anova <- anova(tri_model)
tri_anova

# Normality 
tri_resid <- residuals(tri_model)
qqnorm(tri_resid, main = "Task 5 Q-Q Plot")
qqline(tri_resid, col = "red")

tri_norm_test <- shapiro.test(tri_resid)
tri_norm_test

# Variance
med$Group <- interaction(med$Diabetes_Mellitus, med$Hepatic_Fat_Accumulation)

bartlett_test <- bartlett.test(Triglyceride ~ Group, data = med)
bartlett_test

# Interaction significance 
p_interaction <- tri_anova["Diabetes_Mellitus:Hepatic_Fat_Accumulation", "Pr(>F)"]
F_interaction <- tri_anova["Diabetes_Mellitus:Hepatic_Fat_Accumulation", "F value"]

p_interaction; F_interaction

# Main effects
p_diabetes <- tri_anova["Diabetes_Mellitus", "Pr(>F)"]
p_hepatic <- tri_anova["Hepatic_Fat_Accumulation", "Pr(>F)"]

p_diabetes; p_hepatic
