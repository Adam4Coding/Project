NODE_ENV=production
PORT=3000
BASE_PATH=/
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vended
SESSION_SECRET=change-me
LOG_LEVEL=info
# Optional: comma-separated list of allowed browser origins
# CORS_ORIGIN=https://vended.com,https://www.vended.com
# Optional: override static asset directory
# STATIC_DIR=/app/artifacts/cartly/dist/public
APP_URL=http://localhost:3000
# Stripe Checkout/Billing. Use test keys locally and live keys in production.
STRIPE_SECRET_KEY=
STRIPE_VENDOR_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional email alerts for new host concierge requests.
# Create an API key at Resend, verify tryvended.com, and set the destination inbox.
RESEND_API_KEY=
HOST_REQUEST_NOTIFICATION_EMAIL=info@tryvended.com
HOST_REQUEST_FROM_EMAIL=Vended <requests@tryvended.com>
